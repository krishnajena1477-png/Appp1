generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }

enum Role { USER ADMIN }
enum SeasonStatus { DRAFT SCHEDULED PUBLISHED UNPUBLISHED ARCHIVED }
enum PassingMethod { FIXED PERCENTAGE }
enum AttemptStatus { IN_PROGRESS SUBMITTED AUTO_SUBMITTED ABANDONED EXPIRED }
enum ProgressStatus { LOCKED AVAILABLE IN_PROGRESS FAILED PASSED COMPLETED }

model User { id String @id @default(cuid()) fullName String email String @unique username String? @unique phone String? passwordHash String role Role @default(USER) active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt attempts Attempt[] progress UserProgress[] notifications Notification[] auditLogs AuditLog[] }
model Season { id String @id @default(cuid()) name String description String status SeasonStatus @default(DRAFT) order Int @default(0) passingMethod PassingMethod @default(PERCENTAGE) passingValue Int @default(80) maxAttempts Int? requirePreviousPass Boolean @default(false) prerequisiteSeasonId String? timerMinutes Int? randomQuestionOrder Boolean @default(false) randomOptionOrder Boolean @default(false) showAnswerReview Boolean @default(false) publishAt DateTime? closeAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt questions Question[] attempts Attempt[] progress UserProgress[] }
model Question { id String @id @default(cuid()) seasonId String season Season @relation(fields:[seasonId], references:[id]) text String explanation String? marks Int @default(1) displayOrder Int @default(0) active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt options Option[] }
model Option { id String @id @default(cuid()) questionId String question Question @relation(fields:[questionId], references:[id], onDelete:Cascade) text String displayOrder Int @default(0) isCorrect Boolean @default(false) }
model Attempt { id String @id @default(cuid()) userId String user User @relation(fields:[userId], references:[id]) seasonId String season Season @relation(fields:[seasonId], references:[id]) status AttemptStatus @default(IN_PROGRESS) startedAt DateTime @default(now()) deadlineAt DateTime? submittedAt DateTime? totalQuestions Int @default(0) answeredCount Int @default(0) correctCount Int @default(0) wrongCount Int @default(0) unansweredCount Int @default(0) earnedMarks Int @default(0) totalMarks Int @default(0) percentage Decimal @default(0) result String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt attemptQuestions AttemptQuestion[] }
model AttemptQuestion { id String @id @default(cuid()) attemptId String attempt Attempt @relation(fields:[attemptId], references:[id], onDelete:Cascade) questionId String questionTextSnapshot String explanationSnapshot String? displayOrder Int marksSnapshot Int correctOptionSnapshot String optionsSnapshot Json answers QuizAnswer[] }
model QuizAnswer { id String @id @default(cuid()) attemptQuestionId String attemptQuestion AttemptQuestion @relation(fields:[attemptQuestionId], references:[id], onDelete:Cascade) selectedOptionId String selectedOptionTextSnapshot String? answeredAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([attemptQuestionId]) }
model UserProgress { id String @id @default(cuid()) userId String user User @relation(fields:[userId], references:[id]) seasonId String season Season @relation(fields:[seasonId], references:[id]) status ProgressStatus @default(AVAILABLE) bestPercentage Decimal @default(0) bestScore Int @default(0) attemptCount Int @default(0) passedAt DateTime? lastAttemptAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([userId,seasonId]) }
model Notification { id String @id @default(cuid()) userId String? user User? @relation(fields:[userId], references:[id]) title String message String type String readAt DateTime? createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) actorId String? actor User? @relation(fields:[actorId], references:[id]) action String targetEntity String targetId String? metadata Json? requestId String createdAt DateTime @default(now()) }
